---
interface SkillGroup {
  title: string;
  skills: string[];
}

const skillGroups: SkillGroup[] = [
  {
    title: "Desarrollo móvil",
    skills: [
      "Kotlin",
      "Android",
      "Jetpack Compose",
      "Kotlin Multiplatform"
    ]
  },
  {
    title: "Arquitectura y datos",
    skills: [
      "Clean Architecture",
      "Room",
      "Retrofit",
      "REST APIs"
    ]
  },
  {
    title: "Web y herramientas",
    skills: [
      "Astro",
      "TypeScript",
      "Git",
      "GitHub"
    ]
  }
];
---

<section
  id="skills"
  class="skills"
  aria-labelledby="skills-title"
>
  <div class="skills-container">

    <header class="section-header">
      <p class="section-label">
        Herramientas
      </p>

      <h2 id="skills-title">
        Tecnologías
      </h2>

      <p class="section-description">
        Tecnologías y herramientas que utilizo o estudio
        para desarrollar soluciones de software.
      </p>
    </header>

    <div class="skills-grid">
      {
        skillGroups.map((group) => (
          <article class="skill-group">
            <h3>{group.title}</h3>

            <ul>
              {
                group.skills.map((skill) => (
                  <li>{skill}</li>
                ))
              }
            </ul>
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .skills {
    padding: 6rem 2rem;
  }

  .skills-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    max-width: 700px;
    margin-bottom: 3rem;
  }

  .section-label {
    margin: 0 0 0.5rem;

    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;

    color: #4b5563;
  }

  h2 {
    margin: 0;

    font-size: clamp(2rem, 5vw, 3rem);
  }

  .section-description {
    margin-top: 1rem;

    font-size: 1.1rem;
    line-height: 1.7;

    color: #4b5563;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 1.5rem;
  }

  .skill-group {
    padding: 2rem;

    border: 1px solid #e5e7eb;
    border-radius: 12px;
  }

  .skill-group h3 {
    margin-top: 0;
    margin-bottom: 1.5rem;

    font-size: 1.25rem;
  }

  .skill-group ul {
    margin: 0;
    padding: 0;

    list-style: none;

    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem;
  }

  .skill-group li {
    padding: 0.5rem 0.8rem;

    border-radius: 6px;

    background: #f3f4f6;

    font-size: 0.95rem;
  }

  @media (max-width: 800px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .skills {
      padding: 4rem 1.5rem;
    }
  }
</style>