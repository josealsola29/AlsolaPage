---
interface SkillGroup {
  title: string;
  skills: string[];
}

const skillGroups: SkillGroup[] = [
  {
    title: "Desarrollo móvil",
    skills: [
      "Kotlin",
      "Android",
      "Jetpack Compose",
      "Kotlin Multiplatform"
    ]
  },
  {
    title: "Arquitectura y datos",
    skills: [
      "Clean Architecture",
      "Room",
      "Retrofit",
      "REST APIs"
    ]
  },
  {
    title: "Web y herramientas",
    skills: [
      "Astro",
      "TypeScript",
      "Git",
      "GitHub"
    ]
  }
];
---

<section
  id="skills"
  class="section"
  aria-labelledby="skills-title"
>
  <div class="container">

    <header class="section-header">

      <p class="section-label">
        Herramientas
      </p>

      <h2
        id="skills-title"
        class="section-title"
      >
        Tecnologías
      </h2>

      <p class="section-description">
        Tecnologías y herramientas que utilizo o estudio
        para desarrollar soluciones de software.
      </p>

    </header>

    <div class="skills-grid">

      {
        skillGroups.map((group) => (
          <article class="skill-group">

            <h3>{group.title}</h3>

            <ul>
              {
                group.skills.map((skill) => (
                  <li>{skill}</li>
                ))
              }
            </ul>

          </article>
        ))
      }

    </div>

  </div>
</section>

<style>
  .skills-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 1.5rem;
  }

  .skill-group {
    padding: 2rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: var(--color-surface);

    box-shadow: var(--shadow-sm);
  }

  .skill-group h3 {
    margin: 0 0 1.5rem;

    font-size: 1.25rem;
  }

  .skill-group ul {
    margin: 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem;

    list-style: none;
  }

  .skill-group li {
    padding: 0.5rem 0.8rem;

    border-radius: var(--radius-sm);

    color: var(--color-primary-hover);
    background: var(--color-primary-soft);

    font-size: 0.95rem;
    font-weight: 550;
  }

  @media (max-width: 800px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>