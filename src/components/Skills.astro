---
import SectionHeader from "./ui/SectionHeader.astro";

import SkillCard from "./ui/SkillCard.astro";

type SkillIcon = "mobile" | "architecture" | "web";

interface SkillGroup {
  title: string;
  description: string;
  icon: SkillIcon;
  skills: string[];
}

const skillGroups: SkillGroup[] = [
  {
    title: "Desarrollo móvil",

    description:
      "Tecnologías orientadas al desarrollo de aplicaciones móviles modernas y mantenibles.",

    icon: "mobile",

    skills: ["Kotlin", "Android", "Jetpack Compose", "Kotlin Multiplatform"],
  },

  {
    title: "Arquitectura y datos",

    description:
      "Herramientas y principios para organizar, persistir y sincronizar información.",

    icon: "architecture",

    skills: ["Clean Architecture", "Room", "Retrofit", "REST APIs"],
  },

  {
    title: "Web y herramientas",

    description:
      "Tecnologías utilizadas para construir, versionar y publicar soluciones de software.",

    icon: "web",

    skills: ["Astro", "TypeScript", "Git", "GitHub"],
  },
];
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeader
      label="Herramientas"
      title="Tecnologías"
      titleId="skills-title"
      description="Tecnologías y herramientas que utilizo o estudio para desarrollar soluciones de software."
    />

    <div class="skills-grid">
      {
        skillGroups.map((group) => (
          <SkillCard
            title={group.title}
            description={group.description}
            icon={group.icon}
            skills={group.skills}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));

    gap: 1.5rem;
  }
</style>
