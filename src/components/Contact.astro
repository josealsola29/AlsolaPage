---
import SectionHeader from "./ui/SectionHeader.astro";
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-content">
      <SectionHeader
        label="Contacto"
        title="¿Hablamos?"
        titleId="contact-title"
        description="Si quieres conversar sobre desarrollo de software, aplicaciones móviles, proyectos tecnológicos o alguna oportunidad de colaboración, puedes contactarme."
        variant="inverse"
        large
      />

      <div class="contact-actions">
        <a
          class="button button-secondary"
          href="https://github.com/josealsola29"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    color: #ffffff;

    background: var(--color-dark);
  }

  .contact-content {
    max-width: 750px;
  }
  
  .contact-actions {
    margin-top: 2.5rem;

    display: flex;
    flex-wrap: wrap;

    gap: 1rem;
  }

  .contact .button-secondary {
    color: var(--color-dark);

    background: #ffffff;
    border-color: #ffffff;
  }

  .contact .button-secondary:hover {
    background: #e2e8f0;
    border-color: #e2e8f0;
  }
</style>
