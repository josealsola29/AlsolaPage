---
import { profile } from "../data/profile";
---

<section class="hero">
  <div class="hero-content container">
    <p class="greeting">Hola, soy</p>

    <h1>
      {profile.name}
    </h1>

    <h2>
      Desarrollador de
      <span>Software</span>
    </h2>

    <p class="description">
      {profile.headline}
    </p>

    <div class="actions">
      <a class="button button-primary" href="#projects"> Ver proyectos </a>

      <a class="button button-secondary" href="#contact"> Contactarme </a>
    </div>

    <div class="hero-stack">
      <p>Tecnologías principales</p>

      <ul aria-label="Tecnologías principales">
        {profile.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;

    min-height: calc(100vh - 72px);

    display: flex;
    align-items: center;

    overflow: hidden;

    background: var(--color-background);
  }

  .hero::before {
    content: "";

    position: absolute;

    width: 620px;
    height: 620px;

    top: -180px;
    right: -120px;

    border-radius: 50%;

    background: radial-gradient(
      circle,
      rgb(37 99 235 / 0.14),
      rgb(37 99 235 / 0.04) 40%,
      transparent 70%
    );

    pointer-events: none;
  }

  .hero::after {
    content: "";

    position: absolute;

    inset: 0 0 auto auto;

    width: 48%;
    height: 100%;

    opacity: 0.22;

    background-image:
      linear-gradient(rgb(37 99 235 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(37 99 235 / 0.12) 1px, transparent 1px);

    background-size: 42px 42px;

    mask-image: linear-gradient(to left, black, transparent);

    pointer-events: none;
  }

  .hero-content {
    position: relative;

    z-index: 1;

    padding-block: 6rem;
  }

  .greeting {
    margin: 0 0 0.75rem;

    color: var(--color-primary);

    font-size: 1rem;
    font-weight: 700;

    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0;

    max-width: 850px;

    font-size: clamp(3.5rem, 9vw, 6.5rem);

    line-height: 0.95;

    letter-spacing: -0.055em;
  }

  h2 {
    margin: 1.25rem 0 0;

    color: var(--color-text-muted);

    font-size: clamp(1.7rem, 4vw, 2.8rem);

    font-weight: 500;

    line-height: 1.15;

    letter-spacing: -0.03em;
  }

  h2 span {
    color: var(--color-primary);
  }

  .description {
    max-width: 650px;

    margin: 2rem 0 0;

    color: var(--color-text-muted);

    font-size: 1.15rem;
    line-height: 1.8;
  }

  .actions {
    margin-top: 2.25rem;

    display: flex;
    flex-wrap: wrap;

    gap: 0.9rem;
  }

  .hero-stack {
    margin-top: 3rem;

    display: grid;

    gap: 0.8rem;
  }

  .hero-stack p {
    margin: 0;

    color: var(--color-text-muted);

    font-size: 0.75rem;
    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.09em;
  }

  .hero-stack ul {
    margin: 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;

    gap: 0.65rem;

    list-style: none;
  }

  .hero-stack li {
    padding: 0.5rem 0.8rem;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-sm);

    color: var(--color-text-muted);

    background: rgb(255 255 255 / 0.75);

    font-size: 0.9rem;
    font-weight: 600;

    backdrop-filter: blur(5px);

    -webkit-backdrop-filter: blur(5px);
  }

  @media (max-width: 600px) {
    .hero {
      min-height: auto;
    }

    .hero::before {
      width: 420px;
      height: 420px;

      top: -150px;
      right: -220px;
    }

    .hero::after {
      width: 80%;

      opacity: 0.16;
    }

    .hero-content {
      padding-block: 5rem;
    }

    h1 {
      font-size: clamp(3.2rem, 15vw, 4.5rem);
    }

    .actions {
      max-width: 320px;

      align-items: stretch;
      flex-direction: column;
    }

    .hero-stack {
      margin-top: 2.5rem;
    }
  }
</style>
