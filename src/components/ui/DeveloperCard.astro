---
import TechBadge from "./TechBadge.astro";

import { profile } from "../../data/profile";

const technologies = profile.technologies.slice(0, 3);
---

<aside class="developer-card" aria-label="Resumen del perfil profesional">
  <div class="card-decoration" aria-hidden="true"></div>

  <header class="identity">
    <div class="monogram" aria-hidden="true">
      JA
    </div>

    <div>
      <p class="profile-label">Perfil</p>

      <h3>{profile.name}</h3>

      <p class="role">{profile.role}</p>
    </div>
  </header>

  <dl class="profile-details">
    <div>
      <dt>Enfoque</dt>

      <dd>{profile.focus}</dd>
    </div>

    <div>
      <dt>Prioridad</dt>

      <dd>{profile.priority}</dd>
    </div>
  </dl>

  <ul class="technologies" aria-label="Tecnologías principales">
    {technologies.map((technology) => (
      <li>
        <TechBadge name={technology} />
      </li>
    ))}
  </ul>

  <div class="profile-note">
    <span class="status-dot" aria-hidden="true"></span>

    <span> Aprendizaje y mejora continua </span>
  </div>
</aside>

<style>
  .developer-card {
    position: relative;

    padding: 2rem;

    overflow: hidden;

    border: 1px solid var(--color-border);

    border-radius: var(--radius-lg);

    background: var(--color-surface);

    box-shadow: 0 18px 50px rgb(15 23 42 / 0.08);
  }

  .card-decoration {
    position: absolute;

    width: 180px;
    height: 180px;

    top: -90px;
    right: -70px;

    border-radius: 50%;

    background: radial-gradient(circle, rgb(37 99 235 / 0.14), transparent 70%);

    pointer-events: none;
  }

  .identity {
    position: relative;

    display: flex;
    align-items: center;

    gap: 1rem;

    padding-bottom: 1.5rem;

    border-bottom: 1px solid var(--color-border);
  }

  .monogram {
    width: 64px;
    height: 64px;

    flex: 0 0 64px;

    display: grid;
    place-items: center;

    border-radius: var(--radius-md);

    color: var(--color-text-inverse);

    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-accent));

    font-size: 1.25rem;
    font-weight: 750;

    letter-spacing: -0.03em;

    box-shadow: 0 10px 25px rgb(37 99 235 / 0.2);
  }

  .profile-label {
    margin: 0 0 0.25rem;

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h3 {
    margin: 0;

    font-size: 1.35rem;

    letter-spacing: -0.02em;
  }

  .role {
    margin: 0.3rem 0 0;

    color: var(--color-text-muted);

    font-size: 0.95rem;
  }

  .profile-details {
    margin: 1.5rem 0;

    display: grid;

    gap: 1rem;
  }

  .profile-details div {
    display: grid;

    gap: 0.3rem;
  }

  .profile-details dt {
    color: var(--color-text-muted);

    font-size: 0.75rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .profile-details dd {
    margin: 0;

    color: var(--color-text);

    font-size: 0.95rem;
    line-height: 1.55;
  }

  .technologies {
    margin: 0 0 1.5rem;

    padding: 0;

    display: flex;
    flex-wrap: wrap;

    gap: 0.6rem;

    list-style: none;
  }

  .profile-note {
    padding-top: 1.25rem;

    display: flex;
    align-items: center;

    gap: 0.6rem;

    border-top: 1px solid var(--color-border);

    color: var(--color-text-muted);

    font-size: 0.85rem;
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;

    flex: 0 0 8px;

    border-radius: 50%;

    background: var(--color-primary);

    box-shadow: 0 0 0 4px var(--color-primary-soft);
  }

  @media (max-width: 420px) {
    .developer-card {
      padding: 1.5rem;
    }

    .identity {
      align-items: flex-start;
    }

    .monogram {
      width: 54px;
      height: 54px;

      flex-basis: 54px;
    }
  }
</style>
