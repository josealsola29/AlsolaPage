---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">

  <div class="project-content">

    {
      project.featured && (
        <p class="featured">
          Proyecto destacado
        </p>
      )
    }

    <h3>
      {project.title}
    </h3>

    <p class="description">
      {project.description}
    </p>

    <ul
      class="technologies"
      aria-label={`Tecnologías utilizadas en ${project.title}`}
    >
      {
        project.technologies.map((technology) => (
          <li>{technology}</li>
        ))
      }
    </ul>

  </div>

  {
    (project.repository || project.demo) && (
      <div class="project-links">

        {
          project.repository && (
            <a
              href={project.repository}
              target="_blank"
              rel="noopener noreferrer"
            >
              Código
            </a>
          )
        }

        {
          project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver proyecto
            </a>
          )
        }

      </div>
    )
  }

</article>

<style>
  .project-card {
    height: 100%;

    padding: 2rem;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    gap: 2rem;

    border:
      1px solid
      var(--color-border);

    border-radius:
      var(--radius-md);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-sm);

    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

@media (hover: hover) and (pointer: fine) {
  .project-card:hover {
    transform: translateY(-3px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .project-card:hover {
    transform: none;
  }
}

  .featured {
    margin: 0 0 0.75rem;

    color: var(--color-primary);

    font-size: 0.8rem;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 0;

    font-size: 1.4rem;
  }

  .description {
    margin: 1rem 0;

    color: var(--color-text-muted);

    line-height: 1.75;
  }

  .technologies {
    margin: 1.5rem 0 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;

    gap: 0.6rem;

    list-style: none;
  }

  .technologies li {
    padding: 0.45rem 0.7rem;

    border-radius:
      var(--radius-sm);

    color:
      var(--color-primary-hover);

    background:
      var(--color-primary-soft);

    font-size: 0.9rem;
    font-weight: 550;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;

    gap: 1rem;
  }

  .project-links a {
    color: var(--color-primary);

    font-weight: 650;

    text-decoration: none;
  }

  .project-links a:hover {
    text-decoration: underline;
  }
</style>