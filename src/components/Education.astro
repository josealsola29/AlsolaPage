---
interface EducationItem {
  title: string;
  institution: string;
  period?: string;
  description?: string;
}

const education: EducationItem[] = [
  {
    title: "Formación en Ingeniería de Software",
    institution: "Formación universitaria y de posgrado",
    description:
      "Estudios orientados al diseño, desarrollo, arquitectura y gestión de soluciones de software."
  },
  {
    title: "Desarrollo de Software",
    institution: "Formación universitaria",
    description:
      "Fundamentos de programación, bases de datos, análisis, diseño y construcción de sistemas."
  },
  {
    title: "Formación continua",
    institution: "Cursos y aprendizaje profesional",
    description:
      "Actualización constante en Android, Kotlin, arquitectura de software y tecnologías modernas."
  }
];
---

<section
  id="education"
  class="section"
  aria-labelledby="education-title"
>
  <div class="container">

    <header class="section-header">

      <p class="section-label">
        Formación
      </p>

      <h2
        id="education-title"
        class="section-title"
      >
        Educación
      </h2>

      <p class="section-description">
        Mi formación académica y aprendizaje continuo
        en desarrollo e ingeniería de software.
      </p>

    </header>

    <div class="education-grid">

      {
        education.map((item) => (
          <article class="education-card">

            <h3>
              {item.title}
            </h3>

            <p class="institution">
              {item.institution}
            </p>

            {
              item.period && (
                <p class="period">
                  {item.period}
                </p>
              )
            }

            {
              item.description && (
                <p class="description">
                  {item.description}
                </p>
              )
            }

          </article>
        ))
      }

    </div>

  </div>
</section>

<style>
  .education-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 1.5rem;
  }

  .education-card {
    height: 100%;

    padding: 2rem;

    border:
      1px solid
      var(--color-border);

    border-radius:
      var(--radius-md);

    background:
      var(--color-surface);

    box-shadow:
      var(--shadow-sm);
  }

  .education-card h3 {
    margin: 0;

    font-size: 1.3rem;
  }

  .institution {
    margin: 0.75rem 0;

    color: var(--color-text-muted);

    font-weight: 600;
  }

  .period {
    color: var(--color-primary);

    font-weight: 600;
  }

  .description {
    margin-bottom: 0;

    color: var(--color-text-muted);

    line-height: 1.75;
  }

  @media (max-width: 850px) {
    .education-grid {
      grid-template-columns: 1fr;
    }
  }
</style>