---
import SectionHeader from "./ui/SectionHeader.astro";

import EducationCard from "./ui/EducationCard.astro";

import { education } from "../data/education";
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <SectionHeader
      label="Formación"
      title="Educación"
      titleId="education-title"
      description="Formación académica especializada en ingeniería de software, complementada con aprendizaje continuo en tecnologías de desarrollo."
    />

    <div class="education-grid">
      {education.map((item, index) => (
        <EducationCard
          index={index + 1}
          title={item.title}
          institution={item.institution}
          period={item.period}
          description={item.description}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .education-grid {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));

    gap: 1.5rem;
  }
</style>
