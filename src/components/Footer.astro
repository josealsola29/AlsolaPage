---
const currentYear = new Date().getFullYear();
---

<footer class="footer">

  <div class="footer-container">

    <p>
      © {currentYear} José Alsola
    </p>

    <p class="footer-description">
      Desarrollado con Astro.
    </p>

  </div>

</footer>

<style>
  .footer {
    padding: 2rem;

    border-top: 1px solid #e5e7eb;
  }

  .footer-container {
    max-width: 1100px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;
  }

  .footer p {
    margin: 0;
  }

  .footer-description {
    color: #6b7280;
  }

  @media (max-width: 600px) {
    .footer {
      padding: 2rem 1.5rem;
    }

    .footer-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>