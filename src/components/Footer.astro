---
const currentYear =
  new Date().getFullYear();
---

<footer class="footer">

  <div class="footer-container container">

    <p>
      © {currentYear} José Alsola
    </p>

    <p class="footer-description">
      Desarrollado con Astro.
    </p>

  </div>

</footer>

<style>
  .footer {
    padding-block: 2rem;

    border-top:
      1px solid
      var(--color-border);
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;
  }

  .footer p {
    margin: 0;
  }

  .footer-description {
    color:
      var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .footer-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>